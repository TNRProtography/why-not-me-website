{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "why-not-me",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2024-09-23",

  // ── KV namespace for dedications ──────────────────────────
  // Find your ID: Cloudflare Dashboard → Workers & Pages → KV
  // Click your DEDICATIONS namespace → the ID is in the URL
  "kv_namespaces": [
    {
      "binding": "DEDICATIONS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],

  // ── Cloudflare Email Service binding ──────────────────────
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],

  // ── Environment variables ─────────────────────────────────
  "vars": {
    "APPROVAL_EMAIL": "why.not.me.nicole.white@gmail.com",
    "SENDER_EMAIL": "noreply@whynotme.co.nz"
  }
}
